<?xml version="1.0"?>

<!-- -->
<package format="2">
  <name>costmapPkg</name>
  <version>0.1.0</version>
  <description>Custom ROS Noetic package for robot nodes and interfaces</description>

  <maintainer email="noslen120860@gmail.com">Gabriel Rodriguez</maintainer>
  <license>FIU</license>


<!-- -->
  <buildtool_depend>catkin</buildtool_depend>

<!-- -->
  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>   <!-- Required for PointCloud2 -->
  <depend>nav_msgs</depend>      <!-- Required for OccupancyGrid and MapMetaData -->
  <depend>geometry_msgs</depend> <!-- Required for Pose -->

<!-- -->
  <build_depend>message_generation</build_depend>
  <exec_depend>message_runtime</exec_depend>
  <exec_depend>costmap_2d</exec_depend>
</package>
